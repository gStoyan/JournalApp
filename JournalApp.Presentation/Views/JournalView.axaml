<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:JournalApp.Business.ViewModels;assembly=JournalApp.Business"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="JournalApp.Presentation.Views.JournalView"
             x:DataType="viewModels:JournalViewModel">
    <Grid Margin="10" RowDefinitions="Auto,Auto,*,50">
        <TextBlock Text="Journal"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0 0 0 10" />

        <TextBox Grid.Row="1"
                 Watermark="Title"
                 Margin="0,0,0,10"
                 Text="{Binding Title}" />

        <TextBox Grid.Row="2" Name="JournalTextBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="14"
                 FontFamily="Consolas"
                 Text="{Binding Content }" />

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="10">
            <Button Content="Save"
                    Background="#007acc" Foreground="White"
                    Width="100" HorizontalAlignment="Center"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>