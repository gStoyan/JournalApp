<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:JournalApp.Business.ViewModels;assembly=JournalApp.Business"
    x:Class="JournalApp.Presentation.Views.ProfileView"
    x:DataType="viewModels:ProfileViewModel"
    x:Name="Root">

    <StackPanel Margin="20">
        <TextBlock Margin="0 5">List of crockery:</TextBlock>
        <ItemsControl ItemsSource="{Binding Journals}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Command="{Binding $parent[ItemsControl].((viewModels:ProfileViewModel)DataContext).OpenJournalCommand}"
                        CommandParameter="{Binding Id}"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        Cursor="Hand">
                        <Border Margin="0,10,0,0"
                                CornerRadius="5"
                                BorderBrush="Gray" BorderThickness="1"
                                Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>