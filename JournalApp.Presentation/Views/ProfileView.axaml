<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:JournalApp.Business.ViewModels;assembly=JournalApp.Business"
    x:Class="JournalApp.Presentation.Views.ProfileView"
    x:DataType="viewModels:ProfileViewModel"
    x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Button.journal-card">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.journal-card:pointerover">
            <Setter Property="Background" Value="#22007ACC" />
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="20">
        <Button Content="Create Journal"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"
                Command="{Binding CreateJournalCommand}" />
        <TextBlock Margin="0 5">Journals:</TextBlock>
        <ItemsControl ItemsSource="{Binding Journals}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button
                        Classes="journal-card"
                        Command="{Binding $parent[ItemsControl].((viewModels:ProfileViewModel)DataContext).OpenJournalCommand}"
                        CommandParameter="{Binding Id}"
                        PointerPressed="JournalCard_PointerPressed"
                        Cursor="Hand">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Delete"
                                          Click="DeleteJournal_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>